# Mouseless Linux udev rules (plan §10.6).
#
# uinput access for the `mouseless` group (same as upstream). Pointer accuracy
# is closed-loop in the daemon (bounded REL steps + cursor re-query); no
# libinput acceleration override is used. `LIBINPUT_ATTR_POINTER_ACCEL` is not
# a public libinput knob, so the old flat-accel rule was removed.

KERNEL=="uinput", GROUP="mouseless", MODE="0660"
