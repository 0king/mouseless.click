;; Mouseless overlay layer for kanata (Phase 1.1).
;; Installed as /etc/kanata/mouseless.kbd, sourced from unicfg.kbd via
;;   (include "mouseless.kbd")
;; Requires in unicfg.kbd (see UNICFG-EDITS.md):
;; - lyr-base: lsft slot (`_`) replaced with `@ml-tap` (ShiftLeft tap trigger)
;; - defcfg: linux-output-device-name + linux-dev-names-exclude
;; Design notes (audit C1, user-accepted): ShiftLeft tap (<200 ms) switches to
;; lyr-mouseless; holding ShiftLeft behaves as plain lsft. The live config's
;; `concurrent-tap-hold yes` already makes fast Shift+key count as hold, which
;; is the main misfire mitigation; ShiftRight is untouched for capitals.

(defalias
  ;; ShiftLeft tap -> overlay; hold -> left shift (tap-hold-release matches
  ;; the HRM style used in unicfg.kbd).
  ml-tap (tap-hold-release 200 200 (layer-switch lyr-mouseless) lsft)
)

;; Clean no-HRM overlay layer: plain cell letters + space; esc exits to base.
;; Every other key is transparent (`_`) so modifiers/passthrough keep working.
;; Column counts mirror defsrc exactly (13/14/14/13/12/7).
(deflayer lyr-mouseless
  (layer-switch lyr-base) _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ a s d f _ _ j k l ; _ _
  _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ spc _ _ _
)
