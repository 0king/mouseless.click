;; Mouseless kanata include (plan §2.3; scaffold for Phase 1.1).
;;
;; Sourced from the main kanata.kbd via `(include mouseless.kbd)`.
;; - Stable output name so the daemon finds it without eventN hardcodes.
;; - Our uinput mouse excluded (loop prevention, plan §8 test #6).
;; - Clean no-HRM overlay layer; ShiftLeft tap trigger retained per audit C1
;;   decision (ShiftRight stays free for capitals during fast typing).
;; - No `cmd` actions anywhere (audit W1).

(defcfg
  linux-output-device-name "kanata-mouseless"
  linux-dev-names-exclude ("mouseless-mouse")
  ;; keep the existing linux-device-detect-mode (keyboard-only) from kanata.kbd
  danger-enable-cmd no)

(deflayer lyr-mouseless
  ;; plain letters: zero suppression work for kanata; the daemon temp-grabs
  ;; the output downstream (plan §2.2)
  a s d f j k l ; spc esc)

;; Trigger sketch (final tap-dance/tap-hold tuning in Phase 1.1 with the
;; fake-clock property tests from plan §8 test #1):
;; ShiftLeft tap (<200ms) -> layer-switch lyr-mouseless; ShiftRight untouched.
