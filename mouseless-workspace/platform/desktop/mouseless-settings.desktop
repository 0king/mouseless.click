[Desktop Entry]
Name=Mouseless Settings
Comment=Configure the Mouseless grid, appearance, behavior, and free mode
Exec=/usr/local/bin/mouseless-settings %u
TryExec=/usr/local/bin/mouseless-settings
Icon=preferences-system
Terminal=false
Type=Application
Categories=GTK;Settings;Utility;
Keywords=mouseless;grid;pointer;mouse;accessibility;overlay;
StartupNotify=true
