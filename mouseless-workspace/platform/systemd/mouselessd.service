# mouselessd systemd unit (plan §5 rule 6, §7; audits G3, W2).
#
# - `After=kanata.service` but deliberately NOT Requires=/BindsTo=: no
#   boot-order dependency; the daemon lazy-waits for TCP + device with backoff.
# - `RuntimeDirectory=mouseless` creates /run/mouseless owned by the service
#   for mouselessd.sock (mode 0770 via UMask); SO_PEERCRED authenticates peers.
# - Kill-switch co-exit (plan §7): kanata TCP EOF -> daemon exits non-zero so
#   the supervisor restarts the stack in order.

[Unit]
Description=Mouseless daemon (grid math, uinput mouse, overlay IPC)
Documentation=file:/usr/local/share/doc/mouseless/README.md
After=kanata.service
Wants=kanata.service
# Kanata death is a normal restart path (kill switch, plan §7). Do not let the
# default start-rate limiter leave the unit failed after a few quick restarts.
StartLimitIntervalSec=0

[Service]
Type=simple
User=mouselessd
Group=mouseless
# Group `mouseless` owns the overlay socket dir only; it must never grant
# input access. `input` is required for the evdev temp-grab of kanata's
# output, and the existing `uinput` group (kanata already has it) for
# /dev/uinput writes.
# Neither supplementary group is ever given to a human account.
SupplementaryGroups=input uinput
RuntimeDirectory=mouseless
RuntimeDirectoryMode=0770
# Last-applied config (config.yaml + config.last-good.yaml) survives restarts.
# StateDirectory also carves a writable path out of ProtectSystem=strict.
StateDirectory=mouseless
StateDirectoryMode=0750
UMask=0007
ExecStart=/usr/local/bin/mouselessd
Restart=on-failure
RestartSec=1s
# No $HOME or display is needed; keep the system read-only and drop privileges.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
LockPersonality=true
NoNewPrivileges=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
